# Get a free key at https://aistudio.google.com/apikey (leave empty to use Ollama)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local backend: fully private and no rate limits (install from https://ollama.com, then: ollama pull llama3.1:8b)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Changing the embedding model requires re-indexing (delete the data folder)
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Cross-encoder used to re-rank search results (set RERANK=0 to disable)
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK=1
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=8
